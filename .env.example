# Copia este archivo como ".env" y completa tus propios valores.
# Nunca subas tu archivo ".env" real (con la key completa) al repositorio.

# API key de OpenAI, usada tanto para generar embeddings como para el LLM de generación.
OPENAI_API_KEY=your-key-here

# Modelo de embeddings usado en build_index.py y query.py.
EMBEDDING_MODEL=text-embedding-3-small

# Modelo de chat/generación usado en query.py.
CHAT_MODEL=gpt-4o-mini